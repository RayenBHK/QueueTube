{
  "manifest_version": 3,
  "name": "QueueTube",
  "version": "0.1.0",
  "description": "Sort YouTube picks into ready Shorts and sleeping video queues.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "QueueTube",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "open-next-short": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the next queued Short"
    },
    "open-next-video": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open the next queued video"
    }
  }
}
